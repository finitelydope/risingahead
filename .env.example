# Copy this file to .env and fill in your values.
# Never commit .env to git — it contains passwords.

# Postgres connection (matches docker-compose.yml)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=financial_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection URL (built from the above)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/financial_platform

# Client identifier — controls which config file gets loaded from config/clients/
CLIENT_NAME=default

# Path to mock data CSVs (simulates Oracle source)
MOCK_DATA_DIR=./mock_data
